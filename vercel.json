{
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/:slug", "destination": "/api/stream?slug=:slug" }
  ],
  "functions": {
    "api/stream.js": { "maxDuration": "max" },
    "api/videos.js": { "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}